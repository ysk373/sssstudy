---
export interface Props {
  seriesName: string;
  currentStoryOrder?: number;
  stories: Array<{
    title: string;
    url: string;
    order: number;
    reading_time?: string;
    published_date?: string;
  }>;
}

const { seriesName, currentStoryOrder, stories } = Astro.props;

// シリーズの小説を順序でソート
const sortedStories = stories.sort((a, b) => a.order - b.order);
---

<nav class="series-navigation">
  <header class="series-header">
    <h3 class="series-title">📚 シリーズ: {seriesName}</h3>
    <p class="series-info">全{stories.length}話</p>
  </header>
  
  <ol class="series-list">
    {sortedStories.map((story) => (
      <li class="series-item" class:list={[
        { 'current': story.order === currentStoryOrder },
        { 'completed': currentStoryOrder && story.order < currentStoryOrder }
      ]}>
        <a href={story.url} class="series-link">
          <div class="story-number">第{story.order}話</div>
          <div class="story-details">
            <h4 class="story-title">{story.title}</h4>
            <div class="story-meta">
              {story.reading_time && (
                <span class="reading-time">📖 {story.reading_time}</span>
              )}
              {story.published_date && (
                <span class="publish-date">📅 {story.published_date}</span>
              )}
            </div>
          </div>
          {story.order === currentStoryOrder && (
            <div class="current-indicator">
              <span>現在読んでいる話</span>
            </div>
          )}
        </a>
      </li>
    ))}
  </ol>
  
  <footer class="series-footer">
    <div class="navigation-buttons">
      {currentStoryOrder && currentStoryOrder > 1 && (
        <a href={sortedStories[currentStoryOrder - 2]?.url} class="nav-button prev">
          ← 前の話
        </a>
      )}
      
      {currentStoryOrder && currentStoryOrder < stories.length && (
        <a href={sortedStories[currentStoryOrder]?.url} class="nav-button next">
          次の話 →
        </a>
      )}
    </div>
  </footer>
</nav>

<style>
  .series-navigation {
    background-color: var(--story-bg-color);
    border: 2px solid var(--story-border-color);
    border-radius: 12px;
    padding: 1.5rem;
    margin: 2rem 0;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
  }
  
  .series-header {
    text-align: center;
    border-bottom: 1px solid var(--story-border-color);
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
  }
  
  .series-title {
    color: var(--story-accent-color);
    font-size: 1.3rem;
    font-weight: 600;
    margin: 0 0 0.5rem 0;
  }
  
  .series-info {
    color: var(--story-highlight-color);
    font-size: 0.9rem;
    margin: 0;
  }
  
  .series-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  
  .series-item {
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.3s ease;
  }
  
  .series-item:hover {
    transform: translateX(5px);
  }
  
  .series-item.current {
    background-color: rgba(107, 91, 115, 0.2);
    border: 2px solid var(--story-accent-color);
  }
  
  .series-item.completed {
    opacity: 0.7;
  }
  
  .series-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    text-decoration: none;
    color: inherit;
    transition: background-color 0.3s ease;
  }
  
  .series-link:hover {
    background-color: rgba(107, 91, 115, 0.1);
  }
  
  .story-number {
    background-color: var(--story-accent-color);
    color: white;
    padding: 0.5rem 0.8rem;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.9rem;
    min-width: 60px;
    text-align: center;
    flex-shrink: 0;
  }
  
  .series-item.completed .story-number {
    background-color: var(--story-highlight-color);
  }
  
  .story-details {
    flex-grow: 1;
  }
  
  .story-title {
    color: var(--story-text-color);
    font-size: 1rem;
    font-weight: 500;
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
  }
  
  .story-meta {
    display: flex;
    gap: 1rem;
    font-size: 0.8rem;
    color: var(--story-highlight-color);
  }
  
  .current-indicator {
    background-color: var(--story-accent-color);
    color: white;
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 500;
    flex-shrink: 0;
  }
  
  .series-footer {
    border-top: 1px solid var(--story-border-color);
    padding-top: 1.5rem;
    margin-top: 1.5rem;
  }
  
  .navigation-buttons {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  
  .nav-button {
    background-color: var(--story-accent-color);
    color: white;
    padding: 0.8rem 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s ease;
    flex: 1;
    text-align: center;
    max-width: 150px;
  }
  
  .nav-button:hover {
    background-color: var(--story-highlight-color);
    transform: translateY(-2px);
  }
  
  .nav-button.prev {
    background-color: var(--story-highlight-color);
  }
  
  .nav-button.next {
    background-color: var(--story-accent-color);
  }
  
  /* レスポンシブ対応 */
  @media (max-width: 768px) {
    .series-navigation {
      padding: 1rem;
    }
    
    .series-link {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.8rem;
    }
    
    .story-number {
      align-self: flex-start;
    }
    
    .navigation-buttons {
      flex-direction: column;
    }
    
    .nav-button {
      max-width: none;
    }
  }
</style>
