---
import {getDocuments} from 'content-structure'
import CardMeta from './CardsMeta.astro'
import yaml from 'js-yaml'

export interface Props {
  code: string;
}

const { code } = Astro.props as Props;

// yamlコードをパース
const config = yaml.load(code);
const {
  content_type,
  width_rem = 20,
  exclude_index = true,
  sort_by = 'published',
  order = 'desc'
} = config;

// content_typeでフィルタリング（例: 'blog', 'stories'）
let entries = await getDocuments({ content_type });

// index.mdを除外
if (exclude_index) {
    entries = entries.filter(entry => entry.slug !== 'index');
}

// ソート処理
if (sort_by) {
    entries.sort((a, b) => {
        const aValue = a.data?.[sort_by] || a[sort_by];
        const bValue = b.data?.[sort_by] || b[sort_by];

        if (aValue === undefined || bValue === undefined) return 0;

        let comparison = 0;
        if (aValue < bValue) comparison = -1;
        if (aValue > bValue) comparison = 1;

        return order === 'desc' ? -comparison : comparison;
    });
}

// 各エントリーにディレクトリパスを追加
const entriesWithDirpath = entries.map(entry => ({
    ...entry,
    dirpath: entry.path ? entry.path.split('/').slice(0, -1).join('/') : ''
}));
---
<div class="cards container">
    {
        entriesWithDirpath.map((entry) => (
            <div class="card">
                <CardMeta data={entry} dirpath={entry.dirpath} />
            </div>
        ))
    }
</div>

<style>
.cards.container{
    padding-top: 2rem;
    padding-bottom: 2rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 2rem;
    max-width: 1400px;
    margin: 0 auto;
}

.card{
    background-color: var(--content-bg-color);
    border: 1px solid rgba(102, 126, 234, 0.15);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
}

.card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
}

.card:hover::before {
    opacity: 1;
}

.card:hover {
    box-shadow: 0 20px 50px rgba(102, 126, 234, 0.25);
    border-color: rgba(102, 126, 234, 0.3);
}

@media (max-width: 700px) {
    .cards.container {
        grid-template-columns: 1fr;
        gap: 1.5rem;
        padding: 1.5rem 1rem;
    }
}
</style>
