---
import yaml from 'js-yaml'

export interface Props {
  code: string;
  dirpath: string;
}

const { code, dirpath } = Astro.props as Props;

const sections = yaml.load(code);
---

<div class="sections-container">
    {sections.map((section) => (
        <a href={section.link} class="section-card">
            <div class="section-icon">{section.icon}</div>
            <div class="section-content">
                <h3 class="section-title">{section.name}</h3>
                <p class="section-description">{section.description}</p>
                <div class="section-meta">
                    <span class="section-count">{section.count}</span>
                    <span class="section-label">{section.label}</span>
                </div>
            </div>
            <div class="section-arrow">→</div>
        </a>
    ))}
</div>

<style>
.sections-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    margin: 2rem 0;
    padding: 0 1rem;
}

.section-card {
    background: linear-gradient(135deg, rgba(139, 115, 85, 0.08) 0%, rgba(139, 115, 85, 0.03) 100%);
    border: 1px solid rgba(139, 115, 85, 0.15);
    border-radius: 16px;
    padding: 2rem;
    text-decoration: none;
    color: var(--content-color);
    display: flex;
    align-items: center;
    gap: 1.5rem;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
}

.section-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(139, 115, 85, 0.1), transparent);
    transition: left 0.6s;
}

.section-card:hover::before {
    left: 100%;
}

.section-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    border-color: rgba(139, 115, 85, 0.3);
    background: linear-gradient(135deg, rgba(139, 115, 85, 0.12) 0%, rgba(139, 115, 85, 0.06) 100%);
}

.section-icon {
    font-size: 2.5rem;
    flex-shrink: 0;
    background: linear-gradient(135deg, #8B7355 0%, #A58D7F 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    transition: transform 0.4s ease;
}

.section-card:hover .section-icon {
    transform: scale(1.1) rotate(5deg);
}

.section-content {
    flex: 1;
    min-width: 0;
}

.section-title {
    font-size: 1.4rem;
    font-weight: 600;
    margin: 0 0 0.5rem 0;
    color: var(--content-color);
    line-height: 1.2;
}

.section-description {
    font-size: 0.95rem;
    color: rgba(224, 224, 224, 0.8);
    margin: 0 0 1rem 0;
    line-height: 1.5;
}

.section-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
}

.section-count {
    background: linear-gradient(135deg, #8B7355 0%, #A58D7F 100%);
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-weight: 600;
    font-size: 0.85rem;
}

.section-label {
    color: rgba(224, 224, 224, 0.7);
    font-weight: 500;
}

.section-arrow {
    font-size: 1.2rem;
    color: rgba(139, 115, 85, 0.6);
    transition: all 0.4s ease;
    flex-shrink: 0;
}

.section-card:hover .section-arrow {
    color: #8B7355;
    transform: translateX(8px);
}

/* モバイル対応 */
@media (max-width: 768px) {
    .sections-container {
        grid-template-columns: 1fr;
        gap: 1.5rem;
        padding: 0;
    }
    
    .section-card {
        padding: 1.5rem;
        gap: 1rem;
    }
    
    .section-icon {
        font-size: 2rem;
    }
    
    .section-title {
        font-size: 1.2rem;
    }
    
    .section-description {
        font-size: 0.9rem;
    }
}

/* ダークモード対応 */
@media (prefers-color-scheme: dark) {
    .section-card {
        background: linear-gradient(135deg, rgba(139, 115, 85, 0.12) 0%, rgba(139, 115, 85, 0.06) 100%);
        border-color: rgba(139, 115, 85, 0.2);
    }
    
    .section-card:hover {
        background: linear-gradient(135deg, rgba(139, 115, 85, 0.18) 0%, rgba(139, 115, 85, 0.1) 100%);
        border-color: rgba(139, 115, 85, 0.4);
    }
}
</style>
