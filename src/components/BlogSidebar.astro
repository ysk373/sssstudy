---
---
<aside class="sidebar">
    <div class="widget profile">
        <h3>Author</h3>
        <div class="profile-content">
            <div class="avatar"></div>
            <p class="name">SSSS Manager</p>
            <p class="bio">個人的に気になったことの備忘録を発信中。Web制作、ブログ運営、資産運用など。</p>
        </div>
    </div>



    <div class="widget categories">
        <h3>Categories</h3>
        <ul>
            <li><a href="/blog">Blog</a></li>
            <li><a href="/stories">Stories</a></li>
            <li><a href="/examples">Examples</a></li>
        </ul>
    </div>
</aside>

<style>
    .sidebar {
        width: 300px;
        flex-shrink: 0;
        margin-left: 1rem;
    }

    .widget {
        background-color: var(--nav-bg-color);
        padding: 1.5rem;
        border-radius: 8px;
        margin-bottom: 2rem;
        border: 1px solid #333;
    }

    .widget h3 {
        margin-top: 0;
        margin-bottom: 1rem;
        font-size: 1.1rem;
        border-bottom: 1px solid #444;
        padding-bottom: 0.5rem;
        color: var(--front-blue);
    }

    .profile-content {
        text-align: center;
    }

    .avatar {
        width: 80px;
        height: 80px;
        background-color: #555;
        border-radius: 50%;
        margin: 0 auto 1rem;
    }

    .name {
        font-weight: bold;
        margin-bottom: 0.5rem;
    }

    .bio {
        font-size: 0.9rem;
        color: #ccc;
        line-height: 1.5;
    }

    .ad-placeholder {
        width: 100%;
        height: 250px;
        background-color: #222;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #666;
        border: 1px dashed #444;
    }

    .categories ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .categories li {
        margin-bottom: 0.5rem;
    }

    .categories a {
        color: var(--content-color);
        text-decoration: none;
        transition: color 0.2s;
    }

    .categories a:hover {
        color: var(--front-blue);
    }

    @media (max-width: 900px) {
        .sidebar {
            width: 100%;
            margin-left: 0;
            margin-top: 2rem;
        }
    }
</style>
