---
import "./colors.css";
import AppBar from "./AppBar.astro";
import BlogSidebar from "@/components/BlogSidebar.astro";
import SideMenu from "./SideMenu.astro";
import { process_toc_list } from "./layout_utils";
import { config } from "@/config";

export interface Props {
    title: string;
    headings?: Array<Object>;
    description?: string;
}

const { title, headings, description } = Astro.props;
const toc_menu_items = process_toc_list(headings);
const pathname = Astro.url.pathname.replace(/\/$/, "");
const isIndexPage =
    pathname.endsWith("/index") ||
    pathname === "" ||
    pathname.endsWith("/blog") ||
    pathname.endsWith("/stories");
---

<html lang="ja">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        {description && <meta name="description" content={description} />}
        <link
            rel="icon"
            type="image/png"
            href={`${config.base}/favicon.png?v=${Date.now()}`}
        />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <div class="appbar-nav_content-footer">
            <header>
                <AppBar />
            </header>
            <main>
                <div class="container">
                    {
                        !isIndexPage && (
                            <div class="toc-sidebar">
                                {toc_menu_items.visible && (
                                    <SideMenu
                                        items={toc_menu_items.items}
                                        category="toc_menu"
                                    />
                                )}
                            </div>
                        )
                    }
                    <article class="content scroll">
                        <div class="article-slot">
                            <slot />
                        </div>
                    </article>
                    {!isIndexPage && <BlogSidebar />}
                </div>
            </main>
            <footer>
                <p>
                    &copy; 2025 SSSSブログ All Rights Reserved. <a
                        href="/admin/login"
                        class="admin-link">管理</a
                    >
                </p>
            </footer>
            <script src="./toc_menu_activation.js"></script>
        </div>
    </body>
</html>

<style>
    body {
        margin: 0;
        font-family: "Noto Sans JP", "Helvetica Neue", Arial, sans-serif;
        display: flex;
        flex-direction: row;
        font-feature-settings: "palt";
        background-color: var(--content-bg-color);
        color: var(--content-color);
        font-size: var(--font-size-base);
        line-height: var(--line-height-base);
        width: 100%;
        max-width: 100vw;
        overflow-x: clip;
    }

    .appbar-nav_content-footer {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        height: 100vh;
        min-width: 0; /* Strict constraint */
    }

    /* ... */

    main {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        height: 80vh;
        width: 100%;
        min-width: 0; /* Strict constraint */
    }

    .container {
        display: flex;
        flex-direction: row;
        width: 100%;
        max-width: 98%; /* Push to edges */
        margin: 0 auto;
        flex-grow: 1;
        overflow: hidden; /* Prevent double scrollbars */
        min-width: 0; /* Strict constraint */
    }

    footer {
        flex-grow: 0;
        background-color: var(--front-blue);
        color: white;
        text-align: center;
        overflow: hidden;
        padding: 12px 0;
        font-size: 14px;
    }

    .content {
        color: var(--content-color);
        background-color: var(--content-bg-color);
        width: 100%;
        flex-grow: 1;
        overflow: auto;
        padding: 20px 12px;
        scroll-behavior: smooth;
        min-width: 0; /* Flex item overflow fix */
    }

    .article-slot {
        max-width: 100%; /* Allow content to widen */
        margin: 0 auto;
        font-size: var(--font-size-base);
        line-height: var(--line-height-base);
        min-width: 0; /* Flex item overflow fix */
    }

    .article-slot :global(.paragraph.text) {
        max-width: 80ch; /* Reading width */
        margin-bottom: 1.5em;
        line-height: var(--line-height-base);
        font-size: var(--font-size-base);
        letter-spacing: 0.01em;
        font-weight: 400;
    }

    /* Prevent overflow for images, videos, code blocks, and tables */
    .article-slot :global(img),
    .article-slot :global(video) {
        max-width: 100%;
        height: auto;
    }

    .article-slot :global(pre) {
        max-width: 100%;
        overflow-x: auto;
    }

    .article-slot :global(table) {
        display: block;
        max-width: 100%;
        overflow-x: auto;
    }

    .scroll::-webkit-scrollbar {
        width: 1rem;
    }
    .scroll::-webkit-scrollbar-track {
        background: var(--content-bg-color);
    }
    .scroll::-webkit-scrollbar-thumb {
        background: var(--scroll-thumb-color);
    }
    .scroll::-webkit-scrollbar-thumb:hover {
        background: var(--scroll-thumb-hover-color);
    }

    .admin-link {
        opacity: 0.05;
        text-decoration: none;
        color: inherit;
        transition: opacity 0.3s;
    }

    .admin-link:hover {
        opacity: 0.5;
    }

    .toc-sidebar {
        width: 250px;
        flex-shrink: 0;
        margin-right: 1rem;
        padding-top: 2rem;
        position: sticky;
        top: 80px;
        max-height: calc(100vh - 100px);
        overflow-y: auto;
    }

    @media (max-width: 1100px) {
        .toc-sidebar {
            display: none;
        }
    }

    @media (max-width: 900px) {
        .appbar-nav_content-footer {
            height: auto;
            min-height: 100vh;
        }
        main {
            height: auto;
        }
        .container {
            flex-direction: column;
            overflow: visible;
        }
        .content {
            padding: 1rem;
        }
        /* Ensure sidebar appears at the bottom and takes full width */
        :global(.sidebar) {
            width: 100% !important;
            margin-left: 0 !important;
            margin-top: 2rem;
        }
    }
</style>
