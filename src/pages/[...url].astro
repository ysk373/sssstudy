---
import Layout from "@/layout/Layout.astro"
import BlogPostLayout from "@/layout/BlogPostLayout.astro"
import AstroMarkdown from '@/components/markdown/AstroMarkdown.astro'
import {getDocuments, getEntry} from 'content-structure'
import {remove_base} from '@/libs/assets.js'

let {url} = Astro.params;
url = remove_base(url)
console.log(`in [...url] > url = ${url}`)
const entry = await getEntry({url: url});
console.log("Entry object:", entry)

export async function getStaticPaths(){
	const documents = await getDocuments({format:"markdown"})
	// Filter out empty URLs (handled by index.astro)
	const pages = documents
		.filter((entry) => entry.url !== "")
		.map((entry)=>({params:{url:entry.url}}))
	return pages
}
const headings = (Object.hasOwn(entry.data,"toc")&&entry.data.toc == false)?[]:entry.data.headings

// Unify layout: Use BlogPostLayout for everything except explicitly excluded pages if any
// Previously: const isBlog = url.startsWith('blog/') || url.startsWith('stories/');
// New: Use BlogPostLayout for about and contact as well to match design
const LayoutComponent = BlogPostLayout;
---
<LayoutComponent title={entry.data.title} headings={headings} description={entry.data.description}>
    <AstroMarkdown node={entry.tree} data={entry.data} />
</LayoutComponent>
